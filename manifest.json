{
  "name": "enhanced-h264ify",
  "version": "3.0.0",
  "manifest_version": 3,
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/alextrv/enhanced-h264ify",
  "default_locale": "en",
  "minimum_chrome_version": "147",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "148.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_optionsTitle__",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtu.be/*"
      ],
      "js": [
        "src/common/config.js",
        "src/content/bridge.js",
        "src/content/loudness.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtu.be/*"
      ],
      "js": [
        "src/content/codec-guard.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "storage"
  ]
}
